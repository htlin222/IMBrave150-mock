[1563.280808,"o","\u001b[1d\u001b[1mRules I'm binding myself to, before seeing results\u001b[m\u000f\u001b[K\u001b[2;3H\u001b[K\n-\u001b[C\u001b[1mAnalysis set:\u001b[m\u000f the 714 matched pairs, Cox clustered on pa\u001b[Cr. Overlap-weighted full cohort\u001b[Cas\u001b[4;3H \u001b[Csensitivity.\u001b[K\u001b[5;5H\u001b[1mI interpret i\u001b[Cteract\u001b[Con p-values only\u001b[m\u000f \u2014\u001b[Cnever \"significan\u001b[C in subgroup X.\" A within-subgroup CI\u001b[K\u001b[6;5Hcross\u001b[Cng 1 means that subgroup\u001b[Cis\u001b[Csmall,\u001b[Cnot\u001b[Cthat\u001b[Cthe\u001b[Cdrug\u001b[Cstops\u001b[Cworking.\u001b[7;5H\u001b[1mMultiplic\u001b[Cty:\u001b[m\u000f 9 tests, Bonferr\u001b[Cni \u03b1 = 0.05/9 = \u001b[1m0.0056\u001b[m\u000f. With\u001b[C9\u001b[Ctests\u001b[Cat\u001b[Cnominal\u001b[C0.05\u001b[CI\u001b[Cexpect\u001b[C\u001b[1m~0.4 \u001b[8;5Hfalse positives by chance alone\u001b[m\u000f,\u001b[Cso\u001b[Cone\u001b[C\"hit\"\u001b[Cat\u001b[Cp\u22480.03\u001b[Cis\u001b[Cnoise\u001b[Cuntil\u001b[Cproven\u001b[Cotherwise.\u001b[9;3H- \u001b[1mReporting floor:\u001b[C\u001b[m\u000fa\u001b[Csubgroup\u001b[Clevel\u001b[Cneeds\u001b[C\u226550\u001b[Cpatients\u001b[Cand\u001b[C\u226520\u001b[Cdeaths,\u001b[Celse\u001b[C\"not\u001b[Cestimable.\"\u001b[10;3H-\u001b[C\u001b[1mNo data-driven cutpoints.\u001b[C\u001b[m\u000fAge\u001b[?25l"]
